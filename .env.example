# =========================================================
# Autonomous Research Agent Configuration
# =========================================================

# ---------------------------------------------------------
# 1. Local LLM Provider (Ollama - Recommended & 100% Free)
# ---------------------------------------------------------
# Any model you pull via `ollama pull <model>` is auto-discovered!
# Examples:
#   ollama pull llama3.2
#   ollama pull deepseek-r1:8b
#   ollama pull qwen2.5:14b
#   ollama pull mistral
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=auto

# ---------------------------------------------------------
# 2. Optional Cloud API Keys (Leave blank to use free Ollama)
# ---------------------------------------------------------
# Google Gemini (Free tier available)
GEMINI_API_KEY=

# OpenAI (GPT-4o, GPT-4o-mini)
OPENAI_API_KEY=

# Groq (Ultra-fast inference: Llama 3.3 70B @ 300+ tok/s)
GROQ_API_KEY=

# OpenRouter (Access 200+ models: Claude 3.5 Sonnet, DeepSeek R1, etc.)
OPENROUTER_API_KEY=

# ---------------------------------------------------------
# 3. Custom / OpenAI-Compatible Server (LM Studio, vLLM, LocalAI)
# ---------------------------------------------------------
# For LM Studio: set URL to http://localhost:1234/v1
# For vLLM: set URL to http://localhost:8000/v1
CUSTOM_LLM_URL=
CUSTOM_LLM_MODEL=
CUSTOM_LLM_API_KEY=not-needed

# ---------------------------------------------------------
# 4. Web Server Network Binding
# ---------------------------------------------------------
HOST=0.0.0.0
PORT=8080
